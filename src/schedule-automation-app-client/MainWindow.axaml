<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:schedule_automation_app_client.Controls"
        xmlns:vm="clr-namespace:schedule_automation_app_client.ViewModels"
        x:Class="schedule_automation_app_client.MainWindow"
        Title="Study Planner - Планировщик учебной нагрузки"
        Width="900"
        Height="650">
    
    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>
    
    <TabControl Margin="10">
        <!-- Вкладка 1: Предметы -->
        <TabItem Header="Предметы">
            <controls:SubjectsTab/>
        </TabItem>
        
        <!-- Вкладка 2: Формула -->
        <TabItem Header="Формула">
            <controls:FormulaTab/>
        </TabItem>
    </TabControl>
    
</Window>