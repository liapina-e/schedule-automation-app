<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:schedule_automation_app_client.ViewModels"
             x:Class="schedule_automation_app_client.Controls.SubjectsTab"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="Добавить предмет"
                    Command="{Binding AddSubjectCommand}"
                    Padding="15,5"/>

            <Button Content="Редактировать"
                    Command="{Binding EditSubjectCommand}"
                    IsEnabled="{Binding CanEditSubject}"
                    Padding="15,5"/>

            <Button Content="Удалить"
                    Command="{Binding DeleteSubjectCommand}"
                    IsEnabled="{Binding CanDeleteSubject}"
                    Padding="15,5"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Subjects}"
                 SelectedItem="{Binding SelectedSubject}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#F8F9FA"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,5">
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <TextBlock Grid.Column="0"
                                       Text=""
                                       FontSize="20"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"
                                           FontSize="16"/>
                                <TextBlock Text="{Binding DisplayInfo}"
                                           Foreground="#666"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="Автомат возможен"
                                           Foreground="#28a745"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           IsVisible="{Binding HasAutoGrade}"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="#E3F2FD"
                                    CornerRadius="10"
                                    Padding="10,5">
                                <TextBlock Text="{Binding TargetGrade}"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Center"/>
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontStyle="Italic"
                       Foreground="#666"/>
        </Border>

    </Grid>

</UserControl>