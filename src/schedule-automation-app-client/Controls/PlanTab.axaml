<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:schedule_automation_app_client.ViewModels"
             x:Class="schedule_automation_app_client.Controls.PlanTab"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding SelectedSubject.Name}"
                           FontSize="18"
                           FontWeight="Bold"
                           IsVisible="{Binding CanEditSubject}"/>
                <TextBlock Text="Выберите предмет во вкладке «Предметы»"
                           FontStyle="Italic"
                           Foreground="#999"
                           IsVisible="{Binding !CanEditSubject}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Рассчитать план"
                    Command="{Binding CalculatePlanCommand}"
                    IsEnabled="{Binding CanCalculatePlan}"
                    Padding="15,7"
                    Background="#1976D2"
                    Foreground="White"/>

        </Grid>

        <Border Grid.Row="1"
                Background="#F0F8FF"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,10"
                IsVisible="{Binding CanEditSubject}">
            <Grid ColumnDefinitions="*,*,*">

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Текущая оценка"
                               Foreground="#666"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentPlan.CurrentGrade, StringFormat={}{0:F1}}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#1976D2"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="→"
                           FontSize="32"
                           Foreground="#999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Целевая оценка"
                               Foreground="#666"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedSubject.TargetGrade}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#28a745"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="16">

                <StackPanel HorizontalAlignment="Center"
                            Spacing="10"
                            IsVisible="{Binding CurrentPlan, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="План ещё не рассчитан"
                               FontSize="16"
                               Foreground="#999"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Настройте формулу и нажмите «Рассчитать план»"
                               Foreground="#bbb"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Background="#FFF3CD"
                        CornerRadius="6"
                        Padding="12">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="CurrentPlan" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                            <Binding Path="CurrentPlan.IsAchievable" Converter="{x:Static BoolConverters.Not}"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Цель недостижима"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="#856404"/>
                        <TextBlock Text="{Binding ServerStatus}"
                                   Foreground="#856404"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding CurrentPlan, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Spacing="8">

                    <TextBlock Text="Оптимальный план:"
                               FontWeight="SemiBold"
                               IsVisible="{Binding CurrentPlan.IsAchievable}"/>

                    <ItemsControl ItemsSource="{Binding CurrentPlan.OptimalPlan}"
                                  IsVisible="{Binding CurrentPlan.IsAchievable}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,6">
                                    <Grid RowDefinitions="Auto,Auto,Auto">

                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ComponentName}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding RequiredGrade, StringFormat={}{0:F2}}"
                                                       Foreground="#1976D2"
                                                       FontWeight="Bold"/>
                                        </Grid>

                                        <StackPanel Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="{Binding CurrentGrade, StringFormat=Сейчас: {0:F2}}"
                                                       Foreground="#666"
                                                       FontSize="12"/>
                                            <TextBlock Text="→"
                                                       Foreground="#999"
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding RequiredGrade, StringFormat=Нужно: {0:F2}}"
                                                       Foreground="#1976D2"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <ProgressBar Grid.Row="2"
                                                     Value="{Binding RequiredGrade}"
                                                     Minimum="0"
                                                     Maximum="10"
                                                     Height="6"
                                                     Margin="0,6,0,0"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#D4EDDA"
                            CornerRadius="6"
                            Padding="12">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="CurrentPlan.IsAchievable"/>
                                <Binding Path="CurrentPlan.OptimalPlan.Count"
                                         Converter="{x:Static ObjectConverters.IsNull}"/>
                            </MultiBinding>
                        </Border.IsVisible>
                        <TextBlock Text="{Binding ServerStatus}"
                                   Foreground="#155724"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>

                <StackPanel IsVisible="{Binding CanEditSubject}"
                            Spacing="10">

                    <TextBlock Text="Что если?"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Введите гипотетические оценки и посмотрите как изменится итог"
                               Foreground="#666"
                               FontSize="12"/>

                    <ItemsControl ItemsSource="{Binding WhatIf.Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WhatIfComponentViewModel">
                                <Border Background="#F8F9FA"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto,120">

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="(зафиксирована)"
                                                           Foreground="#999"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           IsVisible="{Binding IsGraded}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentGrade, StringFormat=Текущая: {0:F1}}"
                                                       Foreground="#666"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="→"
                                                   Foreground="#999"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"/>

                                        <NumericUpDown Grid.Column="2"
                                                       Value="{Binding HypotheticalGrade}"
                                                       Minimum="0"
                                                       Maximum="10"
                                                       Increment="0.5"
                                                       FormatString="F1"
                                                       IsEnabled="{Binding !IsGraded}"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border CornerRadius="8"
                            Padding="15"
                            Background="{Binding WhatIf.HypotheticalGradeColor}">
                        <TextBlock Text="{Binding WhatIf.HypotheticalGradeText}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontStyle="Italic"
                           Foreground="#666"/>
                <TextBlock Grid.Column="1"
                           Text="Загрузка..."
                           Foreground="#1976D2"
                           IsVisible="{Binding IsLoading}"/>
            </Grid>
        </Border>

    </Grid>

</UserControl>