<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="schedule_automation_app_client.Controls.FormulaTab">
    
    <Grid Margin="15">
        <!-- Простой текст пока -->
        <StackPanel HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Spacing="20">
            
            <TextBlock Text=""
                      FontSize="48"
                      HorizontalAlignment="Center"/>
            
            <TextBlock Text="Формула оценки"
                      FontSize="20"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"/>
            
            <Border Background="#F0F8FF"
                    Padding="20"
                    CornerRadius="10"
                    Width="400">
                <StackPanel>
                    <TextBlock Text="Эта вкладка будет показывать:"
                              FontWeight="SemiBold"
                              Margin="0,0,0,10"/>
                    
                    <StackPanel Spacing="5" Margin="10">
                        <TextBlock Text="• Список компонентов формулы"/>
                        <TextBlock Text="• Вес каждого компонента"/>
                        <TextBlock Text="• Сложность компонентов"/>
                        <TextBlock Text="• Текущие оценки"/>
                        <TextBlock Text="• Сумму весов (должна быть 100%)"/>
                    </StackPanel>
                    
                    <Separator Margin="0,15,0,10"/>
                    
                    <TextBlock Text="Выберите предмет во вкладке 'Предметы'"
                              FontStyle="Italic"
                              Foreground="#666"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <TextBlock Text="В разработке..."
                      FontStyle="Italic"
                      Foreground="#999"/>
        </StackPanel>
    </Grid>
</UserControl>