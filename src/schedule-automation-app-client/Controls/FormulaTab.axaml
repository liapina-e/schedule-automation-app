<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:schedule_automation_app_client.ViewModels"
             x:Class="schedule_automation_app_client.Controls.FormulaTab"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding SelectedSubject.Name}"
                           FontSize="18"
                           FontWeight="Bold"
                           IsVisible="{Binding CanEditSubject}"/>
                <TextBlock Text="Выберите предмет во вкладке «Предметы»"
                           FontStyle="Italic"
                           Foreground="#999"
                           IsVisible="{Binding !CanEditSubject}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Content="+ Добавить компонент"
                        Command="{Binding AddComponentCommand}"
                        IsEnabled="{Binding CanAddComponent}"
                        Padding="12,5"/>
                <Button Content="Удалить"
                        Command="{Binding DeleteComponentCommand}"
                        IsEnabled="{Binding CanDeleteComponent}"
                        Padding="12,5"/>
            </StackPanel>

        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding CurrentFormula}"
                  SelectedItem="{Binding SelectedComponent}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  IsVisible="{Binding CanEditSubject}"
                  CellEditEnded="OnCellEditEnded">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Вес (%)"
                                    Binding="{Binding Weight}"
                                    Width="90"/>

                <DataGridTextColumn Header="Сложность (1-10)"
                                    Binding="{Binding Complexity}"
                                    Width="130"/>

                <DataGridTextColumn Header="Текущая оценка"
                                    Binding="{Binding CurrentGrade}"
                                    Width="130"/>

                <DataGridCheckBoxColumn Header="Зафиксирована"
                                        Binding="{Binding IsGraded}"
                                        Width="120"/>

                <DataGridCheckBoxColumn Header="Блокирующий"
                                        Binding="{Binding IsBlocking}"
                                        Width="110"/>

                <DataGridCheckBoxColumn Header="Автомат"
                                        Binding="{Binding IsAutoGrade}"
                                        Width="80"/>

                <DataGridTemplateColumn Header="Мин. для автомата" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AutoGradeMinScore, StringFormat={}{0:F1}}"
                                       VerticalAlignment="Center"
                                       Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <NumericUpDown Value="{Binding AutoGradeMinScore}"
                                           Minimum="0"
                                           Maximum="10.1"
                                           Increment="0.1"
                                           FormatString="F1"
                                           IsEnabled="{Binding IsAutoGrade}"
                                           ClipValueToMinMax="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

        <Border Grid.Row="2"
                Background="#FFF8E1"
                CornerRadius="6"
                Padding="12"
                Margin="0,6,0,0"
                IsVisible="{Binding CanSelectBlockingMinimum}">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">

                <TextBlock Text="Минимум для блокирующего компонента:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <ComboBox SelectedItem="{Binding SelectedComponent.BlockingMinimum}"
                          ItemsSource="{Binding BlockingMinimumOptions}"
                          Width="80"/>

                <TextBlock Text="(3.5 — если преподаватель не округляет)"
                           Foreground="#888"
                           FontSize="11"
                           VerticalAlignment="Center"/>

            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="5"
                Background="{Binding FormulaStatusColor}"
                IsVisible="{Binding CanEditSubject}">
            <TextBlock Text="{Binding TotalWeightMessage}"
                       Foreground="White"
                       FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Row="4"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontStyle="Italic"
                       Foreground="#666"/>
        </Border>

    </Grid>

</UserControl>